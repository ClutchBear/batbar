# ============ 本机调试产物（不属于源码）============
# _tmp/ 是开发期临时脚本与抓包输出，含大量一次性探针
_tmp/
*.log
# 例外：probes/ 下的样本日志是精选出来要分发的
!probes/*.log
agent.pid
last-known.json

# ============ 第三方源码参考（体积大，非本仓库内容）============
# OpenLogi（Rust 项目）仅作协议参考的本地快照，不应随本仓库分发
OpenLogi-master/

# ============ 虚拟环境（体积大且含本机绝对路径）============
.venv/
.venv-win/
venv/
env/
ENV/

# ============ 发布产物（本机 build-exe.bat / CI 都会生成）============
package/
batbar-*.zip

# ============ Python 构建/缓存 ============
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
# 瘦身实验（batbar-slim.spec）的产物，同 build/ dist/ 一样只是本机二进制
build-slim/
dist-slim/
wheels/
pip-wheel-metadata/

# 测试与静态检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============ 编辑器 / IDE ============
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# ============ 操作系统 ============
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ============ 绿色模式运行期产物 ============
# 打包后数据落在 exe 同目录（"绿色软件"形态，见 更新记录.md §6-J）。dist/ 本身已忽略，
# 这几条是防手滑：万一有人把 exe 拷到仓库根目录跑、或把 BATBAR_DATA_DIR 指到仓库，
# 也不至于把日志/电量表提交进去（电量表里有设备名，属于个人数据）。
/logs/
/last-known.json
/agent.pid
/batbar.exe
